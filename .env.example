# Credenciales de tu app en el Uber Developer Dashboard
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# Scopes que Uber habilitó para tu app (separados por espacio)
UBER_SCOPES="eats.store eats.order eats.store.status.write eats.report"
# UUID de la tienda en Uber Eats
UBER_STORE_ID=
# true = acepta pedidos automáticamente al recibirlos
UBER_AUTO_ACCEPT=false

# Contraseña del panel (usuario: admin)
ADMIN_PASSWORD=

# Base de datos: Upstash Redis (Vercel Marketplace > Upstash). Vercel las crea solas.
KV_REST_API_URL=
KV_REST_API_TOKEN=
